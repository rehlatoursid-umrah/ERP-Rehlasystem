# Copy to /home/deploy/rehlatours/shared/env/legacy-erp.env on the VPS, mode 600.
# Never commit the real file.

# --- PostgreSQL (container only, no host port) ---
POSTGRES_DB=rehla_erp
POSTGRES_USER=rehla_erp
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX
DATABASE_URL=postgresql://rehla_erp:REPLACE_WITH_64_HEX@postgres:5432/rehla_erp

# --- Auth (NextAuth v5) ---
# Keep the SAME secret as the old Vercel deployment only if existing sessions must survive.
NEXTAUTH_SECRET=REPLACE
AUTH_SECRET=REPLACE
NEXTAUTH_URL=https://erp.rehlatours.id
AUTH_URL=https://erp.rehlatours.id
AUTH_TRUST_HOST=true

# --- Files (replaces Cloudflare R2) ---
FILES_PUBLIC_URL=https://erp.rehlatours.id/files

# --- WhatsApp via WAHA ---
WA_API_URL=https://wa-rehlatours.example
WA_API_KEY=REPLACE
WA_SESSION=default
WA_ADMIN_PHONE=62XXXXXXXXXX

# --- Other ---
EXCHANGE_RATE_API_KEY=REPLACE
WEBSITE_URL=https://rehlatours.id
