# OLD system credentials, used only by deploy/migrate/migrate-data.sh.
# Copy to /home/deploy/rehlatours/shared/env/legacy-source.env on the VPS, mode 600.
# Delete that file after Supabase and R2 are decommissioned. Never commit it.

# Supabase DIRECT connection (port 5432, not the 6543 pooler)
SUPABASE_DIRECT_URL=postgresql://USER:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# Cloudflare R2 (read-only use)
R2_ENDPOINT=https://ACCOUNT.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_BUCKET_NAME=REPLACE
R2_PUBLIC_URL=https://pub-XXXX.r2.dev
